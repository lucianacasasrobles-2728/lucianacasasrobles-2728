<svg xmlns="http://www.w3.org/2000/svg"
     width="600" height="300"
     viewBox="0 0 600 300">

  <defs>
    <linearGradient id="wing" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#b7f3ff" stop-opacity=".8"/>
      <stop offset="55%" stop-color="#c6b5ff" stop-opacity=".65"/>
      <stop offset="100%" stop-color="#f5a9ef" stop-opacity=".3"/>
    </linearGradient>

    <linearGradient id="body" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#74e3f5"/>
      <stop offset="100%" stop-color="#a78bfa"/>
    </linearGradient>
  </defs>

  <g>
    <animateTransform
      attributeName="transform"
      type="translate"
      values="0 0; 0 -9; 0 0"
      dur="4s"
      repeatCount="indefinite"/>

    <g transform="translate(300 145) rotate(-20)">

      <!-- Wings -->
      <g fill="url(#wing)" stroke="#b7e9ff"
         stroke-width="1.5">

        <g>
          <animateTransform
            attributeName="transform"
            type="scale"
            values="1 1; 1 .88; 1 1"
            dur=".7s"
            repeatCount="indefinite"/>

          <ellipse cx="-85" cy="-36" rx="92" ry="23"
                   transform="rotate(20 -85 -36)"/>
          <ellipse cx="85" cy="-36" rx="92" ry="23"
                   transform="rotate(-20 85 -36)"/>
        </g>

        <ellipse cx="-75" cy="35" rx="85" ry="20"
                 transform="rotate(-20 -75 35)"/>
        <ellipse cx="75" cy="35" rx="85" ry="20"
                 transform="rotate(20 75 35)"/>
      </g>

      <!-- Tail -->
      <path d="M0 20 Q8 80 0 125"
            fill="none" stroke="url(#body)"
            stroke-width="8" stroke-linecap="round"/>

      <!-- Body -->
      <ellipse cx="0" cy="0" rx="13" ry="30"
               fill="url(#body)"/>

      <!-- Head -->
      <circle cx="0" cy="-35" r="13"
              fill="#80e5f4"/>

      <circle cx="-7" cy="-38" r="5"
              fill="#8b7cf5"/>
      <circle cx="7" cy="-38" r="5"
              fill="#8b7cf5"/>

      <!-- Glow -->
      <circle cx="0" cy="0" r="5"
              fill="#ffffff" opacity=".8">
        <animate attributeName="opacity"
                 values=".3;1;.3"
                 dur="2s"
                 repeatCount="indefinite"/>
      </circle>
    </g>
  </g>
</svg>
